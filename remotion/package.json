{
  "name": "vocify-video",
  "version": "1.0.0",
  "description": "Vocify animated product demo video",
  "scripts": {
    "start": "remotion preview",
    "build": "remotion render index.ts vocify-demo --codec=h264 --crf 18",
    "build-output": "remotion render index.ts vocify-demo --codec=h264 --crf 18 -o ./out.mp4",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@remotion/google-fonts": "4.0.435",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
