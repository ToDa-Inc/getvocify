# Vocify Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# AI SERVICES
# ===========================================

# Speechmatics - live copilot WebSocket
# Get your API key from: https://speechmatics.com
SPEECHMATICS_API_KEY=

# Deepgram Nova-3 - HubSpot recordings, uploads, WhatsApp file STT
# Get your API key from: https://console.deepgram.com
DEEPGRAM_API_KEY=
STT_PROVIDER=deepgram
STT_LANGUAGE=es
STT_DEEPGRAM_MODEL=nova-3

# OpenRouter - LLM API (for GPT-5-mini, GPT-4o, etc.)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# CRM analysis: notes, fields, what to update, transcript/diarization repair
EXTRACTION_MODEL=google/gemini-3.5-flash-lite
TRANSCRIPT_SANITIZE_MODEL=google/gemini-3.5-flash-lite

# Live Call Copilot — abortable text model via OpenRouter
# Avoid google/gemini-3.6-flash here (mandatory reasoning ~4s TTFT)
# Gemini 3.1 Flash Live requires Google Live API (not OpenRouter chat)
COPILOT_MODEL=google/gemini-3.5-flash-lite

# ===========================================
# DATABASE & AUTH (Supabase)
# ===========================================

# Supabase Project URL
# From: Project Settings > API > Project URL
SUPABASE_URL=

# Supabase Anonymous Key (safe for frontend)
# From: Project Settings > API > anon public
SUPABASE_ANON_KEY=

# Supabase Service Role Key (backend only, never expose!)
# From: Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (REQUIRED - the app refuses to start without it)
# From: Project Settings > API > JWT Secret
# Used by /auth/refresh to verify (signature + expiry) any token it uses to
# decide whose session to touch when GoTrue's own refresh call fails (see
# app/api/auth.py's refresh_token docstring). Without this, that check has
# no basis to trust the caller's claimed identity.
SUPABASE_JWT_SECRET=

# ===========================================
# CRM INTEGRATIONS
# ===========================================

# HubSpot OAuth Credentials
# Create app at: https://developers.hubspot.com
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/v1/crm/hubspot/callback

# HubSpot Private App Token (for scripts, e.g. create_hubspot_properties.sh)
# Create at: HubSpot Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=

# Salesforce OAuth (Connected App — Web Server flow)
# Required for GET /api/v1/crm/salesforce/authorize to work (otherwise 503).
# Callback URL in Salesforce must match SALESFORCE_REDIRECT_URI exactly.
# SALESFORCE_LOGIN_BASE=https://login.salesforce.com
# For sandbox use: https://test.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8888/api/v1/crm/salesforce/callback

# ===========================================
# APPLICATION
# ===========================================

# Environment (development, staging, production)
ENVIRONMENT=development

# API Base URL (for frontend - must match backend port, typically 8888)
VITE_API_URL=http://localhost:8888/api/v1

# Frontend URL (for OAuth callbacks)
FRONTEND_URL=http://localhost:5173

# JWT Secret (REQUIRED - the app refuses to start without it, or if it's left
# as a placeholder). Signs the OAuth "state" param for HubSpot/Salesforce
# connect flows (see app/config.py's validate_startup_config). Generate a
# real random value, e.g. `openssl rand -hex 32` - do NOT leave this empty
# or copy an example value verbatim, especially in a public repo.
JWT_SECRET=

# ===========================================
# WHATSAPP (optional)
# ===========================================
# Meta WhatsApp Business API - for voice-to-CRM via WhatsApp
# App: https://developers.facebook.com/apps → Your App → WhatsApp
# WHATSAPP_ACCESS_TOKEN=     # Page/System User token (permanent for production)
# WHATSAPP_PHONE_NUMBER_ID=  # Phone number ID from WhatsApp > API Setup (e.g. 626059637077495)
# WHATSAPP_VERIFY_TOKEN=     # Custom string you enter in Meta webhook config - must match
# WHATSAPP_APP_SECRET=       # App Dashboard > Settings > Basic. Verifies X-Hub-Signature-256
#                            # on incoming webhooks - without it, anyone who finds the webhook
#                            # URL can POST fake WhatsApp messages.

# ===========================================
# UNIPILE (optional - WhatsApp via Unipile)
# ===========================================
# Unipile API - alternative to Meta for WhatsApp (no business verification)
# UNIPILE_API_KEY=
# UNIPILE_BASE_URL=https://api23.unipile.com:15349  # optional, has default
# UNIPILE_WEBHOOK_SECRET=    # Unipile dashboard > your webhook endpoint. Verifies the
#                            # unipile-signature header - without it, anyone who finds the
#                            # webhook URL can inject fake WhatsApp messages.

# HubSpot call recording webhooks (optional setup script: backend/scripts/setup_hubspot_webhooks.py)
# HUBSPOT_APP_ID=
# HUBSPOT_DEVELOPER_API_KEY=
# Production: https://api.getvocify.com/webhooks/hubspot
# Local: make backend && make ngrok && make ngrok-url  → paste printed URL (ends with /webhooks/hubspot)
# HUBSPOT_WEBHOOK_TARGET_URL=

# Public URL of this backend (OAuth callbacks). File STT no longer waits on Speechmatics webhooks.
# Production: https://api.getvocify.com
# Local: your ngrok HTTPS URL if you still expose HubSpot app webhooks
# BACKEND_PUBLIC_URL=https://api.getvocify.com

# ===========================================
# ERROR TRACKING (optional, strongly recommended in production)
# ===========================================
# Get a free DSN at https://sentry.io (New Project > Python > FastAPI).
# Without this, the only way to learn about a production failure is a
# customer complaint or manually grepping logs.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
